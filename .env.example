# --- Identity ---
NODE_ID=node1

# --- Client-facing HTTP API (Fastify) ---
HTTP_PORT=8080

# --- Peer-facing gRPC (node-to-node) ---
GRPC_PORT=9080

# --- Other nodes: comma-separated id@host:port (id = that peer's NODE_ID) ---
PEERS=node2@node2:9080,node3@node3:9080

# --- Failure detection / election tuning (ms) ---
HEARTBEAT_MS=250
ELECTION_TIMEOUT_MIN_MS=1000
ELECTION_TIMEOUT_MAX_MS=2000
